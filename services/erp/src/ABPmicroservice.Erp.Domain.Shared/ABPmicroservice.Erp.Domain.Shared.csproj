<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>ABPmicroservice.Erp</RootNamespace>
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Volo.Abp.Validation" Version="10.6.1" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Localization\Erp\*.json" />
        <Content Remove="Localization\Erp\*.json" />
    </ItemGroup>

</Project>
