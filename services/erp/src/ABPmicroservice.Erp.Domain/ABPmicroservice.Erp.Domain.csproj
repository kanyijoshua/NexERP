<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>ABPmicroservice.Erp</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Volo.Abp.Ddd.Domain" Version="10.6.1" />
        <PackageReference Include="Volo.Abp.SettingManagement.Domain" Version="10.6.1" />
        <ProjectReference Include="..\ABPmicroservice.Erp.Domain.Shared\ABPmicroservice.Erp.Domain.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- RDLC layouts that ship with the system; converted when a company is seeded. -->
        <EmbeddedResource Include="Reporting\BundledLayouts\*.rdl;Reporting\BundledLayouts\*.rdlc" LogicalName="ABPmicroservice.Erp.Reporting.BundledLayouts.%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
